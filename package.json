{
  "name": "xflow",
  "version": "0.1.0",
  "private": true,
  "description": "A privacy-conscious Manifest V3 extension that filters X timelines and replies with Jev.",
  "type": "module",
  "scripts": {
    "build": "bun run theme:check && bun run scripts/build.ts",
    "benchmark:cache": "sh scripts/cache-benchmark.sh",
    "format": "bunx oxfmt --write .",
    "format:check": "bunx oxfmt --check .",
    "lint": "bunx oxlint . --deny-warnings",
    "lint:fix": "bunx oxlint . --fix",
    "preview:dashboard": "bun run build && bun run scripts/preview-dashboard.ts",
    "build:site": "bun run scripts/build-site.ts",
    "preview:site": "bun run build:site && bun run scripts/preview-site.ts",
    "preview:tokens": "bun run scripts/preview-tokens.ts",
    "typecheck": "bunx tsc --noEmit",
    "test": "bun test",
    "theme:build": "bunx astryx theme build src/themes/neutral/neutralTheme.ts",
    "theme:check": "bunx astryx theme build --check src/themes/neutral/neutralTheme.ts",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun test && bun run build"
  },
  "dependencies": {
    "@astryxdesign/core": "^0.6.3",
    "@astryxdesign/theme-neutral": "^0.6.3",
    "@openrouter/sdk": "^1.3.8",
    "@stylexjs/stylex": "^0.19.1",
    "@typesafe-ai/sdk": "^0.6.0",
    "ai": "^7.0.107",
    "clsx": "^2.1.1",
    "framer-motion": "^13.4.1",
    "lucide-react": "^1.47.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@astryxdesign/cli": "^0.6.3",
    "@tailwindcss/cli": "^4.3.3",
    "@types/bun": "latest",
    "@types/chrome": "^0.3.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5"
  },
  "packageManager": "bun@1.3.13"
}
