{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 120,
  "semi": true,
  "singleQuote": false,
  "sortPackageJson": true,
  "sortTailwindcss": {
    "stylesheet": "./src/dashboard/styles/dashboard.css",
    "functions": ["cn"]
  },
  "ignorePatterns": [
    "dist/**",
    "node_modules/**",
    "output/**",
    ".playwright-cli/**",
    ".agents/**",
    ".claude/**",
    "coverage/**",
    "src/themes/neutral/neutral.css",
    "src/themes/neutral/neutral.js",
    "src/themes/neutral/neutral.d.ts",
    "src/themes/neutral/neutral.variants.d.ts",
    "bun.lock"
  ]
}
