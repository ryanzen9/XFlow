{
  "manifest_version": 3,
  "name": "XFlow",
  "version": "0.1.0",
  "description": "Jev For X, Use Jev to automate content filtering on X, creating a customized, comfortable, and clean browsing experience.",
  "permissions": ["storage", "alarms"],
  "optional_host_permissions": ["https://*/*", "http://localhost/*", "http://127.0.0.1/*"],
  "options_ui": { "page": "dashboard.html", "open_in_tab": true },
  "host_permissions": ["https://openrouter.ai/*", "https://ai-gateway.vercel.sh/*", "https://api.typesafe.ai/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "XFlow Settings",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
